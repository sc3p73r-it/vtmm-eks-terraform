# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*
!.terraform.lock.hcl

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars.json

# Ignore override files as they are usually used to override resources locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include tfplan files
*.tfplan

# OS files
.DS_Store
.idea/
.vscode/
*.swp

# Git
*.orig